def Shape as (Float l, Float u, PolyExp L, PolyExp La, PolyExp U){[(curr[l]<=curr),(curr[u]>=curr),(curr[L]<=curr),(curr[La]<=curr),(curr[U]>=curr)]};

func simplify_lower(Neuron n, Float coeff) = (coeff >= 0.0) ? (coeff * n[l]) : (coeff * n[u]);
func simplify_upper(Neuron n, Float coeff) = (coeff >= 0.0) ? (coeff * n[u]) : (coeff * n[l]);

func replace_lower1(Neuron n, Float coeff) = (coeff >= 0.0) ? (coeff *  n[L]) : (coeff * n[U]);
func replace_lower2(Neuron n, Float coeff) = (coeff >= 0.0) ? (coeff * n[La]) : (coeff * n[U]);
func replace_upper1(Neuron n, Float coeff) = (coeff >= 0.0) ? (coeff * n[U]) : (coeff * n[L]);
func replace_upper2(Neuron n, Float coeff) = (coeff >= 0.0) ? (coeff * n[U]) : (coeff * n[La]);

func priority(Neuron n) = n[layer];
func priority2(Neuron n, Float c) = -n[layer];
func stop(Neuron n) = false;
func stop_traverse(Neuron n, Float c) = false;

func backsubs_lower1(PolyExp e, Neuron n) = (e.traverse(backward, priority2, stop_traverse, replace_lower1){e <= n}).map(simplify_lower);
func backsubs_upper1(PolyExp e, Neuron n) = (e.traverse(backward, priority2, stop_traverse, replace_upper1){e >= n}).map(simplify_upper);
func backsubs_lower2(PolyExp e, Neuron n) = (e.traverse(backward, priority2, stop_traverse, replace_lower2){e <= n}).map(simplify_lower);
func backsubs_upper2(PolyExp e, Neuron n) = (e.traverse(backward, priority2, stop_traverse, replace_upper2){e >= n}).map(simplify_upper);

func relu(Float x) = x >= 0.0 ? x : 0.0;
func relu_lower(Neuron n)  = n[l] + n[u] >= 0.0 ? n : 0.0;
// The opposite choice of the lower bound is store in La.
func relu_lower2(Neuron n) = n[l] + n[u] >= 0.0 ? 0.0 : n;
func relu_upper(Neuron n) = n[l] >= 0.0 ? n : (n[u] <= 0.0 ? 0.0 : (((n[u]) / ((n[u]) - (n[l]))) * n) - (((n[u]) * (n[l])) / ((n[u]) - (n[l]))));

// NOTE (compiler bug)!!:
// Parallelization assumes a transformer has exactly two
// traverse loops (one for l, one for u) and runs them in two threads. With more
// than two loops Python raises UnboundLocalError at run time. 
// Workaround: run with CF_NO_PARALLEL=1,
// which skips the pass (compile.py), so both back-substitution chains can be
// used inside l and u.
transformer deeppoly{
    Affine -> (max(backsubs_lower1(prev.dot(curr[weight]) + curr[bias], curr),backsubs_lower2(prev.dot(curr[weight]) + curr[bias], curr)),
               min(backsubs_upper1(prev.dot(curr[weight]) + curr[bias], curr),backsubs_upper2(prev.dot(curr[weight]) + curr[bias], curr)),
               prev.dot(curr[weight]) + curr[bias],
               prev.dot(curr[weight]) + curr[bias],
               prev.dot(curr[weight]) + curr[bias]);
    Relu -> (relu(prev[l]), relu(prev[u]), relu_lower(prev), relu_lower2(prev), relu_upper(prev));
}

flow(forward, priority, stop, deeppoly);
